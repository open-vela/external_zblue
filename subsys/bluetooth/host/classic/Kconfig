config BT_HFP_HF_HF_INDICATOR_BATTERY
	bool "HF Indicator Battery level for HFP HF [EXPERIMENTAL]"
	select BT_HFP_HF_HF_INDICATORS
	help
	  This option enables HF Indicator Battery level for HFP HF

endif # BT_HFP_HF

